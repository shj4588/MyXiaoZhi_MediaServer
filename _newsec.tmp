  /* ② v1.7.50：同一份已经在转 ⇒ **不再另起一条 ffmpeg**，直接跟着那个 .part 文件读。
     旧写法是「等 6 秒，等不到就自己再起一条」，实测播放器一次起播会发两条连接
     （预读 + 正式），两条各跑一个 24/96 转码 ⇒ 2.4x 的转码速度被劈成 1.2x，
     缓冲永远攒不满 —— 设备侧表现就是 playing 但 stalled 一路涨。 */
  const live0 = LIVE.get(key);
  if (live0) return followLive(req, res, live0, prof, o, tag);

  /* ④ 未命中：起一条转码（单飞），自己跟着读。
   * 三条硬约束（挨个踩过）：
   *   ① 响应头照抄 /radio/：`Accept-Ranges: none` + chunked + 无 Content-Length。
   *      写 `bytes` 会诱使播放器去发 Range，而这条管道不支持 Range ⇒ 只能从头再来。
   *   ② 重采样 filter_size=4（见 buildArgs）：24/96 → 44.1k 从 1.0x 提到 2.1x。
   *   ③ **一条 ffmpeg 服务所有连接**（LIVE 表 + 文件跟随），缓存与连接生死解耦：
   *      客户端断了只是少一个读文件的人，转码照转、缓存照落。
   */
  const live = await startLive(abs, rel, prof, tag, key);
  if (!live) {
    // 起不来转码 ⇒ 退回直发源文件（至少还有一次机会）
    try { if (sendFile) sendFile(res, req, abs, o.ct || 'audio/flac', o.onCommit); } catch { /* ignore */ }
    return 'fail';
  }
  return followLive(req, res, live, prof, o, tag);
}

/* ------------------------------------------------- v1.7.50 单飞转码 + 文件跟随 */

/* key -> { partPath, bytes, done, ok, committed }
   同一个文件只跑一条 ffmpeg；每条 HTTP 连接各自从 .part 的 0 开始读、读到当前末尾就等。
   这样既不会把转码算力劈开，又天然支持"预读连接 + 正式连接"同时在线。 */
const LIVE = new Map();

function sleepMs(n) { return new Promise(r => setTimeout(r, n)); }

/**
 * 边转边发：从 0 读 .part，读到文件当前末尾就等，直到整首转完或客户端断开。
 * 不用 createReadStream —— 它在"文件暂时没有新数据"时会直接 EOF，正好把流截断。
 */
async function followLive(req, res, live, prof, o, tag) {
  const headers = {
    'Content-Type': prof.codec === 'mp3' ? 'audio/mpeg' : 'audio/aac',
    'Cache-Control': 'no-cache',
    'Accept-Ranges': 'none',
    'X-Audio-Transcode': '1',
    'X-Audio-Format': prof.codec + '/' + prof.br + 'k/' + prof.rate + '/' + prof.ch,
  };
  try { res.writeHead(200, headers); } catch { return 'fail'; }

  // .part 由 startLive 创建，这里可能早了一拍 ⇒ 等它出现（最多 3 秒）
  let fh = null;
  for (let i = 0; i < 100 && !fh; i++) {
    if (res.destroyed || res.writableEnded) return 'fail';
    try { fh = await fs.promises.open(live.partPath, 'r'); } catch { await sleepMs(30); }
  }
  if (!fh) { try { res.end(); } catch { /* ignore */ } return 'fail'; }

  let pos = 0;
  let mine = false;
  try {
    for (;;) {
      if (res.destroyed || res.writableEnded) break;
      const buf = Buffer.allocUnsafe(65536);      // 每拍新分配：write 只是排队，复用会被覆盖
      let n = 0;
      try { const r = await fh.read(buf, 0, buf.length, pos); n = r.bytesRead; } catch { n = 0; }
      if (n > 0) {
        pos += n;
        if (!mine && pos >= 32768) {              // 真吐出 32KB 才算"这次起播成立了"（记账口径不变）
          mine = true;
          if (!live.committed) {
            live.committed = true;
            if (typeof o.onCommit === 'function') { try { o.onCommit(); } catch { /* ignore */ } }
          }
        }
        let ok = true;
        try { ok = res.write(buf.subarray(0, n)); } catch { ok = false; }
        if (!ok) {
          await new Promise(done => {
            const f = () => { res.removeListener('drain', f); res.removeListener('close', f); done(); };
            res.once('drain', f); res.once('close', f);
          });
        }
        continue;
      }
      if (live.done) break;                       // 转完且读到末尾 ⇒ 正常收工
      await sleepMs(40);                          // 转码还在追进度，等下一坨
    }
  } finally { try { await fh.close(); } catch { /* ignore */ } }
  if (!res.destroyed && !res.writableEnded) { try { res.end(); } catch { /* ignore */ } }
  return 'stream';
}

/** 起一条转码并登记到 LIVE；返回 live 句柄（起不来返回 null） */
async function startLive(abs, rel, prof, tag, key) {
  while (JOBS >= prof.maxJobs) await sleepMs(200);
  const p = cachePaths(key);
  const partPath = p.part + '.' + process.pid + '.' + (++PART_SEQ);
  const live = { partPath, bytes: 0, done: false, ok: false, committed: false };
  LIVE.set(key, live);
  JOBS++;

  const ctx = await startTranscode(abs, prof);
  if (!ctx.child) { JOBS--; LIVE.delete(key); return null; }
  console.log('[aac] 实时转码 ' + tag + ' → ' + prof.tag + '（并发 ' + JOBS + '/' + prof.maxJobs + '）');

  let ws = null;
  try { ws = fs.createWriteStream(partPath); } catch { ws = null; }
  let idleAt = Date.now();
  const watchdog = setInterval(() => {
    if (Date.now() - idleAt > 120000) {
      console.log('[aac] 转码 120s 无产出，放弃：' + tag);
      try { ctx.child.kill('SIGKILL'); } catch { /* ignore */ }
    }
  }, 5000);
  if (watchdog.unref) watchdog.unref();

  ctx.child.stdout.on('data', ch => {
    idleAt = Date.now();
    live.bytes += ch.length;
    if (ws) { try { ws.write(ch); } catch { /* ignore */ } }
  });
  ctx.child.stdout.on('error', () => { /* 断管由 done 收尾 */ });

  ctx.done.then(ok => {
    clearInterval(watchdog);
    JOBS--;
    const finish = () => {
      live.ok = ok;
      if (ok && live.bytes > 0) {
        if (prof.codec === 'mp3') {
          // MP3 自带帧同步，直接就是可 Range 的缓存文件，不用重封装
          try { fs.renameSync(partPath, p.mp3); } catch { /* ignore */ }
        } else {
          try { fs.renameSync(partPath, p.aac); } catch { /* ignore */ }
          remux(key).catch(() => {});
        }
        console.log('[aac] 缓存完成 ' + tag + ' ' + (live.bytes / 1048576).toFixed(1) + 'MB');
        enforceLimit().catch(() => {});
      } else {
        try { fs.unlinkSync(partPath); } catch { /* ignore */ }
      }
      live.done = true;        // 收尾做完才放行读者，免得他们读到"还没刷盘"的末尾
      LIVE.delete(key);
    };
    // ws.end 的回调在数据真正刷进文件之后才来（rename 之前必须等它）
    if (ws) { try { ws.end(finish); } catch { finish(); } } else { finish(); }
  });

  return live;
}
